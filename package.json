{
  "name": "steam-stats",
  "version": "0.1.0",
  "private": false,
  "description": "Local Steam library playtime, spending, and shelf-value analytics dashboard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/parthUltra/steam-stats.git"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "test": "npm run test:unit",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "test:integration": "tsx --test --import ./tests/setup.ts \"tests/integration/**/*.test.ts\"",
    "test:security": "tsx --test --import ./tests/setup.ts \"tests/security/**/*.test.ts\"",
    "test:e2e": "node tests/prepare-root.mjs && playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:e2e",
    "verify": "npm run typecheck && npm run lint && npm run test:all",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "fixture:build": "tsx tests/fixtures/build-library-a.ts",
    "fetch:account-data": "tsx scripts/fetch-account-data.ts",
    "fetch:owned-games": "tsx scripts/fetch-owned-games.ts",
    "parse:account-data": "tsx scripts/parse-account-data.ts",
    "fetch:transactions": "tsx scripts/fetch-transactions.ts",
    "refresh:prices": "tsx scripts/refresh-prices.ts",
    "sync:gifts-gmail": "tsx scripts/sync-gifts-gmail.ts",
    "launch": "bash scripts/launch.sh",
    "launch:fast": "STEAM_STATS_SKIP_PRICES=1 bash scripts/launch.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.62.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.7",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
