# Steam Stats environment
#
# Everything here is optional. The app works with this file left as it is.
# `npm run launch` copies it to `.env.local` if you have none; to do it by hand:
#   cp .env.example .env.local && chmod 600 .env.local
#
# `.env.local` is read by the Next.js server (npm run dev / start / launch) and
# by the terminal scripts (npm run refresh:prices, ...).
#
# No Steam Web API key is needed: the library fetch uses the access token from
# your Steam session.

# IsThereAnyDeal API key, for Steam store all-time lows
# Preferred: Value tab -> Get store lows, then paste the key in the app. That
# key is saved to data/itad-credentials.json (owner-only), never to this file,
# and takes precedence over the value below.
# This variable is read only as a fallback when no key is saved in the app.
# Create a key at https://isthereanydeal.com/apps/
# Store country and currency are detected from your purchase and login history.
ISTHEREANYDEAL_API_KEY=

# Gifts from Gmail need no setting here and no mail password:
# Value tab -> Sync from Gmail opens a separate browser window to sign in.

# --- Advanced, usually set on the command line rather than here ---
#
# STEAM_STATS_ROOT=/path/to/folder
#   Read samples/, data/ and the session folders from another data root.
#   The tests use this to run against the synthetic fixture:
#     node tests/prepare-root.mjs
#     STEAM_STATS_ROOT=.test-root STEAM_STATS_OFFLINE=1 npm run dev
#
# STEAM_STATS_OFFLINE=1
#   Refuse every outbound request and background process.
#
# STEAM_STATS_DEBUG_SCRAPE=1
#   Keep the raw text of the last Gmail scrape in
#   .gmail-session/last-scrape.txt (off by default; it contains mail content).

# --- Security notes ---
#
# - The server answers only on localhost / 127.0.0.1 / [::1].
# - To call a POST or DELETE route from a terminal, send the Origin header:
#     curl -X POST -H 'Origin: http://127.0.0.1:3000' http://127.0.0.1:3000/api/refresh-prices
