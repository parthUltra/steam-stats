# Steam Stats environment

# Optional — Steam Web API key (https://steamcommunity.com/dev/apikey)
# Improves some library endpoints. Session-based fetch covers most playtime.
STEAM_API_KEY=

# Optional — IsThereAnyDeal API key for Steam India all-time lows
# Prefer Value tab → Get India lows (opens Apps page; paste key back in the app).
# Or set manually from https://isthereanydeal.com/apps/
ISTHEREANYDEAL_API_KEY=

# Copy this file to `.env.local` and fill values as needed:
#   cp .env.example .env.local
#
# Gifts from Gmail: no mail passwords here — use Value → Sync from Gmail
# (opens a browser, same idea as Steam Account Data login).
